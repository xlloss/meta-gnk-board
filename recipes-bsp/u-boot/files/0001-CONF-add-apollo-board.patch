From 3e42c05bcbc541a7e526f4e2c5e183dba6b7a0a5 Mon Sep 17 00:00:00 2001
From: "Slash.Huang" <slash.linux.c@gmail.com>
Date: Sun, 29 Dec 2024 01:13:00 +0800
Subject: [PATCH] [CONF] add apollo board

---
 arch/arm/dts/Makefile            |   3 +-
 arch/arm/dts/rzg2l-apollo.dts    | 118 +++++++++++++++++++++++++++++++
 arch/arm/mach-rmobile/Kconfig.64 |   5 ++
 board/renesas/rzg2l-dev/Kconfig  |  16 +++++
 configs/rzg2l-apollo_defconfig   |  78 ++++++++++++++++++++
 include/configs/rzg2l-apollo.h   |  77 ++++++++++++++++++++
 6 files changed, 296 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm/dts/rzg2l-apollo.dts
 create mode 100644 configs/rzg2l-apollo_defconfig
 create mode 100644 include/configs/rzg2l-apollo.h

diff --git a/arch/arm/dts/Makefile b/arch/arm/dts/Makefile
index f566afc744..ddeff6b0c8 100644
--- a/arch/arm/dts/Makefile
+++ b/arch/arm/dts/Makefile
@@ -933,7 +933,8 @@ dtb-$(CONFIG_RCAR_GEN3) += \
 	rzg2ul-type2-dev.dtb \
 	smarc-rzg2ul.dtb \
 	smarc-rzv2l-gnk.dtb \
-	smarc-rzg2l-gnk.dtb
+	smarc-rzg2l-gnk.dtb \
+	rzg2l-apollo.dtb \
 
 ifdef CONFIG_RCAR_GEN3
 DTC_FLAGS += -R 4 -p 0x1000
diff --git a/arch/arm/dts/rzg2l-apollo.dts b/arch/arm/dts/rzg2l-apollo.dts
new file mode 100644
index 0000000000..aa5d6786e5
--- /dev/null
+++ b/arch/arm/dts/rzg2l-apollo.dts
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Device Tree Source for the GNK board
+ *
+ * Copyright (C) 2017 Jacopo Mondi <jacopo+renesas@jmondi.org>
+ * Copyright (C) 2016 Renesas Electronics
+ * slash.liunx.c@gmail.com
+ */
+
+/dts-v1/;
+#include <dt-bindings/gpio/gpio.h>
+#include "r9a07g044l.dtsi"
+#include "r9a07g044l-u-boot.dtsi"
+#include <dt-bindings/pinctrl/rzg2l-pinctrl.h>
+
+/ {
+	model = "rzg2l-apollo";
+	compatible = "renesas,r9a07g044l", "renesas,rzg2l";
+
+	aliases {
+		serial0 = &scif0;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@48000000 {
+		device_type = "memory";
+		/* first 128MB is reserved for secure area. */
+		reg = <0 0x48000000 0 0x38000000>;
+	};
+
+};
+
+&pinctrl {
+	eth0_pins: eth0 {
+		pinmux = <RZG2L_PINMUX(20, 0, 1)>,
+				<RZG2L_PINMUX(20, 1, 1)>,
+				<RZG2L_PINMUX(20, 2, 1)>,
+				<RZG2L_PINMUX(21, 0, 1)>,
+				<RZG2L_PINMUX(21, 1, 1)>,
+				<RZG2L_PINMUX(22, 0, 1)>,
+				<RZG2L_PINMUX(22, 1, 1)>,
+				<RZG2L_PINMUX(23, 0, 1)>,
+				<RZG2L_PINMUX(23, 1, 1)>,
+				<RZG2L_PINMUX(24, 0, 1)>,
+				<RZG2L_PINMUX(24, 1, 1)>,
+				<RZG2L_PINMUX(25, 0, 1)>,
+				<RZG2L_PINMUX(25, 1, 1)>,
+				<RZG2L_PINMUX(26, 0, 1)>,
+				<RZG2L_PINMUX(26, 1, 1)>,
+				<RZG2L_PINMUX(27, 0, 1)>,
+				<RZG2L_PINMUX(27, 1, 1)>,
+				<RZG2L_PINMUX(28, 0, 1)>,
+				<RZG2L_PINMUX(28, 1, 1)>;
+	};
+
+	i2c1_pins: i2c1 {
+		pinmux = <RZG2L_PINMUX(14, 2, 1)>,
+				<RZG2L_PINMUX(14, 3, 1)>;
+	};
+
+};
+
+&xinclk {
+        clock-frequency = <24000000>;
+};
+
+&scif0 {
+	status = "okay";
+	clock = <100000000>;
+};
+
+&sdhi0 {
+	/* pinctrl placeholder
+	 * If this channel is used for interfacing with a SD card, a power enable
+	 * pin (SD0_PWR_EN) must be defined.
+	 * The SD0_PWR_EN pin is associated with P4_1.
+	 * A HIGH signal on SD0_PWR_EN will enable supply voltage for SD card.
+	*/
+	bus-width = <8>;
+	status = "okay";
+};
+
+&sdhi1 {
+	/* pinctrl placeholder
+	 * A power enable pin (SD1_PWR_EN) must be defined to interface with a
+	 * SD card.
+	 * The SD1_PWR_EN pin is associated with P39_2.
+	 * A HIGH signal on SD1_PWR_EN will enable supply voltage for SD card.
+	*/
+	bus-width = <4>;
+	status = "okay";
+};
+
+&eth0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&eth0_pins>;
+	status = "okay";
+
+	phy-handle = <&phy0>;
+	phy-mode = "rgmii";
+	phy0: ethernet-phy@7 {
+		reg = <7>;
+	};
+};
+
+&i2c1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c1_pins>;
+	status = "okay";
+
+	adv7535: hdmi@3d {
+		compatible = "adi,adv7535";
+		reg = <0x3d>;
+	};
+};
diff --git a/arch/arm/mach-rmobile/Kconfig.64 b/arch/arm/mach-rmobile/Kconfig.64
index 6d9b0602d8..d7a90321b0 100644
--- a/arch/arm/mach-rmobile/Kconfig.64
+++ b/arch/arm/mach-rmobile/Kconfig.64
@@ -202,6 +202,11 @@ config TARGET_SMARC_RZG2L_GNK
 	help
           Support for Renesas RZ/G2L Dev Platform
 
+config TARGET_RZG2L_APOLLO
+	bool "RZ/G2L APOLLO board"
+	help
+          Support for Renesas RZ/G2L apollo Platform
+
 config TARGET_RZG2LC_DEV
 	bool "RZ/G2LC Dev board"
 	help
diff --git a/board/renesas/rzg2l-dev/Kconfig b/board/renesas/rzg2l-dev/Kconfig
index 9a8941a79d..8429273aee 100644
--- a/board/renesas/rzg2l-dev/Kconfig
+++ b/board/renesas/rzg2l-dev/Kconfig
@@ -45,3 +45,19 @@ config SYS_CONFIG_NAME
 	default "smarc-rzg2l-gnk"
 
 endif
+
+if TARGET_RZG2L_APOLLO
+
+config SYS_SOC
+	default "rmobile"
+
+config SYS_BOARD
+	default "rzg2l-dev"
+
+config SYS_VENDOR
+	default "renesas"
+
+config SYS_CONFIG_NAME
+	default "rzg2l-apollo"
+
+endif
