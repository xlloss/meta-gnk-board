From ed8fe8d5bc2f29b4c7a6d0c8cff30707d6cb9011 Mon Sep 17 00:00:00 2001
From: slash <slash.linux.c@gmail.com>
Date: Tue, 1 Apr 2025 14:29:50 +0800
Subject: [PATCH 47/50] [DTS|DSI] change mipi dsi to 4-lans

---
 arch/arm64/boot/dts/renesas/rz-gnk-smarc-common.dtsi | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/renesas/rz-gnk-smarc-common.dtsi b/arch/arm64/boot/dts/renesas/rz-gnk-smarc-common.dtsi
index 30a0b030431c..1b76d6b9eefa 100644
--- a/arch/arm64/boot/dts/renesas/rz-gnk-smarc-common.dtsi
+++ b/arch/arm64/boot/dts/renesas/rz-gnk-smarc-common.dtsi
@@ -423,7 +423,7 @@ &du {
 
 &dsi0 {
 	status = "disabled";
-	data-lanes = <1 2>;
+	data-lanes = <1 2 3 4>;
 
 	#address-cells = <1>;
 	#size-cells = <0>;
@@ -433,7 +433,7 @@ port@1 {
 			reg = <1>;
 			dsi0_out: endpoint {
 				remote-endpoint = <&panel_in>;
-				data-lanes = <1 2>;
+				data-lanes = <1 2 3 4>;
 			};
 		};
 	};
-- 
2.34.1

