-	};
-
-	panel_rgb: panel_rgb {
-		status = "disabled";
-		compatible = "panel-dpi";
-		backlight = <&pwm_backlight>;
-		enable-gpios = <&pinctrl RZG2L_GPIO(47, 2) GPIO_ACTIVE_LOW>;
-		power-supply = <&vdd_panel_3v3>;
