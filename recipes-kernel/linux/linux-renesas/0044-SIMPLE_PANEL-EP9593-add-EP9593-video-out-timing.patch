Subject: [PATCH 44/50] [SIMPLE_PANEL|EP9593] add EP9593 video-out timing

---
 drivers/gpu/drm/panel/panel-simple.c | 46 +++++++++++++++++++---------
 1 file changed, 32 insertions(+), 14 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-simple.c b/drivers/gpu/drm/panel/panel-simple.c
index 2da64faa31d5..5f5bb98c1a87 100644
--- a/drivers/gpu/drm/panel/panel-simple.c
+++ b/drivers/gpu/drm/panel/panel-simple.c
@@ -4537,17 +4537,35 @@ static const struct drm_display_mode osd101t2045_53ts_mode = {
 	.flags = DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC,
 };
 
-static const struct drm_display_mode fake_dsi_mode = {
-	.clock = 49000,
-	.hdisplay = 1024,
-	.hsync_start = 1024 + 5,
-	.hsync_end = 1024 + 5 + 13,
-	.htotal = 1024 + 5 + 13 + 270,
-	.vdisplay = 600,
-	.vsync_start = 600 + 2,
-	.vsync_end = 600 + 2 + 3,
-	.vtotal = 600 + 2 + 3 + 17,
-	.flags = DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC,
+static const struct display_timing fake_dsi_timing[] = {
+	{
+		.pixelclock = { 49000, 49000, 49000 },
+		.hactive = { 1024, 1024, 1024 },
+		.hfront_porch = { 5, 5, 5 },
+		.hback_porch = { 270, 270, 270 },
+		.hsync_len = { 13, 13, 13 },
+		.vactive = { 600, 600, 600 },
+		.vfront_porch = { 2, 2, 2 },
+		.vback_porch = { 17, 17, 17 },
+		.vsync_len = { 3, 3, 3 },
+		.flags = DISPLAY_FLAGS_DE_HIGH | DISPLAY_FLAGS_PIXDATA_POSEDGE |
+			DISPLAY_FLAGS_HSYNC_HIGH | DISPLAY_FLAGS_VSYNC_HIGH |
+			DISPLAY_FLAGS_SYNC_POSEDGE,
+	},
+	{
+		.pixelclock = { 74250, 74250, 74250 },
+		.hactive = { 1280, 1280, 1280 },
+		.hfront_porch = { 110, 110, 110 },
+		.hback_porch = { 220, 220, 220 },
+		.hsync_len = { 40, 40, 40 },
+		.vactive = { 720, 720, 720 },
+		.vfront_porch = { 5, 5, 5 },
+		.vback_porch = { 20, 20, 20 },
+		.vsync_len = { 5, 5, 5 },
+		.flags = DISPLAY_FLAGS_DE_HIGH | DISPLAY_FLAGS_PIXDATA_POSEDGE |
+			DISPLAY_FLAGS_HSYNC_HIGH | DISPLAY_FLAGS_VSYNC_HIGH |
+			DISPLAY_FLAGS_SYNC_POSEDGE,
+	}
 };
 
 static const struct panel_desc_dsi osd101t2045_53ts = {
@@ -4570,8 +4588,8 @@ static const struct panel_desc_dsi osd101t2045_53ts = {
 
 static const struct panel_desc_dsi fake_dsi_panel = {
 	.desc = {
-		.modes = &fake_dsi_mode,
-		.num_modes = 1,
+		.timings = fake_dsi_timing,
+		.num_timings = 1,
 		.bpc = 8,
 		.size = {
 			.width = 0,
@@ -4583,7 +4601,7 @@ static const struct panel_desc_dsi fake_dsi_panel = {
 		 MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
 		 MIPI_DSI_MODE_EOT_PACKET,
 	.format = MIPI_DSI_FMT_RGB888,
-	.lanes = 2,
+	.lanes = 4,
 };
 
 static const struct of_device_id dsi_of_match[] = {
