From 69d81b7419811cdf3dd81c43a2b903de54673c60 Mon Sep 17 00:00:00 2001
From: "slash.huang" <slash.linux.c@gmail.com>
Date: Wed, 14 Jan 2026 17:11:22 +0800
Subject: [PATCH 2/2] [SCI] enable sci port0

---
 arch/arm64/boot/dts/renesas/r9a07g044l2-apollo.dtsi       | 6 ++++++
 arch/arm64/boot/dts/renesas/rzg2l-apollo-pinfunction.dtsi | 5 +++++
 2 files changed, 11 insertions(+)

diff --git a/arch/arm64/boot/dts/renesas/r9a07g044l2-apollo.dtsi b/arch/arm64/boot/dts/renesas/r9a07g044l2-apollo.dtsi
index b84e06fcdf29..44a56d8e9295 100644
--- a/arch/arm64/boot/dts/renesas/r9a07g044l2-apollo.dtsi
+++ b/arch/arm64/boot/dts/renesas/r9a07g044l2-apollo.dtsi
@@ -66,3 +66,9 @@ &i2c0 {
 &du {
 	status = "okay";
 };
+
+&sci0 {
+	pinctrl-0 = <&sci0_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/renesas/rzg2l-apollo-pinfunction.dtsi b/arch/arm64/boot/dts/renesas/rzg2l-apollo-pinfunction.dtsi
index d48ea51fecb9..1861084b9861 100644
--- a/arch/arm64/boot/dts/renesas/rzg2l-apollo-pinfunction.dtsi
+++ b/arch/arm64/boot/dts/renesas/rzg2l-apollo-pinfunction.dtsi
@@ -167,4 +167,9 @@ clk {
 	adc_pins: adc {
 		pinmux = <RZG2L_PORT_PINMUX(42, 2, 1)>; /* ADC_TRG */
 	};
+
+	sci0_pins: sci0 {
+		pinmux = <RZG2L_PORT_PINMUX(0, 0, 2)>, /* RxD */
+			 <RZG2L_PORT_PINMUX(0, 1, 2)>; /* TxD */
+	};
 };
